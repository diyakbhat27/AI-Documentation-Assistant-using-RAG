# ============================================================
# LioranDB AI Assistant — Environment Configuration
# ============================================================
# HOW TO USE:
#   1. Copy this file:  cp .env.example .env
#   2. Replace every value marked REPLACE_WITH_YOUR_...
#   3. Never commit your .env file (it is in .gitignore)
# ============================================================

# LLM Provider (only gemini supported)
LLM_PROVIDER=groq


GROQ_API_KEY=REPLACE_WITH_YOUR_GROQ_API_KEY
# Embedding model — do not change
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ChromaDB persistent storage path
CHROMA_PATH=./chroma_db

# SQLite database path
SQLITE_DB=./data/query_logs.db

# Docs base URL — do not change
DOCS_BASE_URL=https://db.lioransolutions.com
